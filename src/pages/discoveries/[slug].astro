---
import Layout from '../../layouts/Layout.astro';
import Experiment from '../../components/Experiment.astro';
import { discoveries, pageUrl } from '../../data/discoveries';
import { Image } from 'astro:assets';
export function getStaticPaths(){return discoveries.map((d,index)=>({params:{slug:d.slug},props:{d,index}}));}
const { d,index }=Astro.props;
const images=import.meta.glob('../../../assets/*.png',{eager:true,import:'default'});
const previous=discoveries[index-1],next=discoveries[index+1];
---
<Layout title={d.title} description={d.idea}><header class="article-head"><a class="back" href={`${pageUrl()}#atlas`}>← Back to the atlas</a><p class="eyebrow">PLATE {String(index+1).padStart(2,'0')} / {d.field}</p><h1>{d.title}</h1><div class="article-meta"><span>{d.date}</span><span class="badge">{d.type}</span></div><p class="lede">{d.idea}</p></header><div class="article-body"><figure class="main-plate"><Image src={images[`../../../assets/${d.image}`] as any} alt={d.alt} width={1448} widths={[640,960,1448]} sizes="(max-width: 700px) 90vw, 1000px" format="webp" loading="eager"/><figcaption>Plate {String(index+1).padStart(2,'0')} · A teaching illustration. <a href={images[`../../../assets/${d.image}`].src}>Open full-size original ↗</a></figcaption></figure><div class="explanation"><section><h2>What changed?</h2><p>{d.intro}</p><p>{d.context}</p><a class="text-link" href={d.source}>{d.sourceLabel} ↗</a></section><aside class="boundary"><h3>The distinction to keep</h3><p>{d.limit}</p></aside></div><Experiment d={d}/><section class="sources"><h2>Follow the research</h2><p><a href={d.source}>{d.sourceLabel} ↗</a></p><p class="small">Source checked September 8, 2026. This explanation summarizes the reported result; it is not an independent proof audit.</p>{d.slug==='navier-stokes'&&<p class="small">The <a href="https://www.claymath.org/wp-content/uploads/2022/06/navierstokes.pdf">official problem formulation</a> sets out the alternatives. OpenAI’s announcement also discusses concurrent research and attribution.</p>}</section><nav class="page-nav" aria-label="Discoveries">{previous?<a href={pageUrl(previous.slug)}><small>← PREVIOUS PLATE</small>{previous.title}</a>:<a href={pageUrl()}><small>← HOME</small>Return to the atlas</a>}{next?<a href={pageUrl(next.slug)}><small>NEXT PLATE →</small>{next.title}</a>:<a href={`${pageUrl()}#atlas`}><small>THE COMPLETE COLLECTION →</small>Explore the atlas again</a>}</nav></div></Layout>
