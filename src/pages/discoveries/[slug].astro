---
import Layout from '../../layouts/Layout.astro';
import Experiment from '../../components/Experiment.astro';
import { research } from '../../data/research';
import { discoveries, pageUrl } from '../../data/discoveries';
import { Image } from 'astro:assets';
export function getStaticPaths(){return discoveries.map((d,index)=>({params:{slug:d.slug},props:{d,index}}));}
const { d,index }=Astro.props;
const images=import.meta.glob('../../../assets/*.png',{eager:true,import:'default'});
const previous=discoveries[index-1],next=discoveries[index+1];
const reading=research[d.slug];
---
<Layout title={d.title} description={d.idea}><header class="article-head"><a class="back" href={`${pageUrl()}#atlas`}>← Back to the atlas</a><p class="eyebrow">PLATE {String(index+1).padStart(2,'0')} / {d.field}</p><h1>{d.title}</h1><div class="article-meta"><span>{d.date}</span><span class="badge">{d.type}</span></div><p class="lede">{d.idea}</p></header><div class="article-body"><figure class="main-plate"><Image src={images[`../../../assets/${d.image}`] as any} alt={d.alt} width={1448} widths={[640,960,1448]} sizes="(max-width: 700px) 90vw, 1000px" format="webp" loading="eager"/><figcaption>Plate {String(index+1).padStart(2,'0')} · A teaching illustration. <a href={images[`../../../assets/${d.image}`].src}>Open full-size original ↗</a></figcaption></figure><div class="explanation"><section><h2>What changed?</h2><p>{d.intro}</p><p>{d.context}</p><a class="text-link" href="#research">Read the original finding and outside perspectives ↓</a></section><aside class="boundary"><h3>The distinction to keep</h3><p>{d.limit}</p></aside></div><Experiment d={d}/><section class="sources" id="research"><h2>Follow the research</h2><p class="small">Start with the finding itself, then read how others explain its meaning. Links checked September 9, 2026. PDF page links may open at the beginning in some readers; the page and section locators below still apply.</p><div class="research-columns">{[{label:'The original finding',links:reading.original},{label:'Outside explanation & community response',links:reading.community}].map(group=><section class="research-group"><h3>{group.label}</h3>{group.links.map(link=><article class="research-reference"><p class="eyebrow">{link.format}</p><h4><a href={link.url}>{link.title} ↗</a></h4><p class="reference-author">{link.by}</p><p>{link.note}</p></article>)}</section>)}</div></section><nav class="page-nav" aria-label="Discoveries">{previous?<a href={pageUrl(previous.slug)}><small>← PREVIOUS PLATE</small>{previous.title}</a>:<a href={pageUrl()}><small>← HOME</small>Return to the atlas</a>}{next?<a href={pageUrl(next.slug)}><small>NEXT PLATE →</small>{next.title}</a>:<a href={`${pageUrl()}#atlas`}><small>THE COMPLETE COLLECTION →</small>Explore the atlas again</a>}</nav></div></Layout>
